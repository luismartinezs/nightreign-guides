{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nightreign-guides",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "nightreignhub.appforgelabs.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
